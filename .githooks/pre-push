#!/usr/bin/env sh
# Portable branch protection pre-push hook (macOS, Linux, Windows Git Bash)
# - Blocks all direct pushes to master, main, and alpha
# - Blocks direct pushes to dev unless EVERY commit being pushed starts with docs: or hotfix:
# Activate once per clone: git config core.hooksPath .githooks

set -eu

ZERO_OID="0000000000000000000000000000000000000000"
ARCHIVE_GATE_DONE=""

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "${remote_ref:-}" ] && continue

  # Archive gate (REQ-SL-04, Decision 3.8): once per push, only for feature-branch updates.
  # Protected targets and mirror syncs (`forge.mjs sync` uses --no-verify) never run it.
  case "$remote_ref" in
    refs/heads/dev|refs/heads/alpha|refs/heads/master|refs/heads/main) ;;
    refs/heads/*)
      if [ -z "$ARCHIVE_GATE_DONE" ] && [ "$local_sha" != "$ZERO_OID" ] && command -v node >/dev/null 2>&1; then
        ARCHIVE_GATE_DONE=1
        node "$(git rev-parse --show-toplevel)/.claude/hooks/archive-gate.mjs" --pre-push </dev/null || exit 1
      fi
      ;;
  esac

  case "$remote_ref" in
    refs/heads/master|refs/heads/main|refs/heads/alpha)
      echo "ERROR: Direct pushes to ${remote_ref#refs/heads/} are blocked." >&2
      echo "Please push to a feature branch and open a Pull Request." >&2
      exit 1
      ;;
    refs/heads/dev)
      if [ "$local_sha" = "$ZERO_OID" ]; then
        echo "ERROR: Deleting dev branch via push is blocked." >&2
        exit 1
      fi

      if [ "$remote_sha" = "$ZERO_OID" ]; then
        if git rev-parse --verify --quiet origin/master >/dev/null 2>&1; then
          RANGE="origin/master..${local_sha}"
        elif git rev-parse --verify --quiet origin/main >/dev/null 2>&1; then
          RANGE="origin/main..${local_sha}"
        elif git rev-parse --verify --quiet master >/dev/null 2>&1; then
          RANGE="master..${local_sha}"
        elif git rev-parse --verify --quiet main >/dev/null 2>&1; then
          RANGE="main..${local_sha}"
        else
          RANGE="$local_sha"
        fi
      else
        RANGE="${remote_sha}..${local_sha}"
      fi

      BAD_COMMITS=""
      for sha in $(git rev-list "$RANGE"); do
        subject=$(git show -s --format=%s "$sha")
        if ! printf '%s\n' "$subject" | grep -Eq '^(docs|hotfix)(\([a-z0-9._/-]+\))?!?: '; then
          BAD_COMMITS="${BAD_COMMITS}  - ${sha} ${subject}\n"
        fi
      done

      if [ -n "$BAD_COMMITS" ]; then
        echo "ERROR: Direct pushes to 'dev' are restricted to 'docs:' and 'hotfix:' commits only." >&2
        echo "The following commits require a feature branch + Pull Request into 'dev':" >&2
        printf '%b' "$BAD_COMMITS" >&2
        exit 1
      fi
      ;;
  esac
done

# Run fast path-scoped compile/build gate (honors NIFTY_SKIP_GATE=1)
if command -v node >/dev/null 2>&1; then
  REPO_ROOT="$(git rev-parse --show-toplevel)"
  if [ -f "${REPO_ROOT}/.claude/hooks/test-gate.mjs" ]; then
    node "${REPO_ROOT}/.claude/hooks/test-gate.mjs"
  fi
fi

exit 0
