# Copy this file to .env for local development. NEVER commit .env to Git.

# --- PostgreSQL ---
POSTGRES_DB=nifty
POSTGRES_USER=nifty
POSTGRES_PASSWORD=nifty_dev_password
POSTGRES_PORT=5432

# --- Application Ports ---
BACKEND_PORT=8080
FRONTEND_PORT=3000
# Docker frontend target: "prod" (Nginx on container port 80) or "dev" (Vite HMR on container port 5173)
FRONTEND_DOCKER_TARGET=prod
FRONTEND_CONTAINER_PORT=80

# --- LLM Evaluator — ki:connect NRW / FH AI (Aachen & NRW, EU-hosted, free for students) ---
# NOTE: Used ONLY for the LLM evaluator (evidence extraction & constrained judging).
# Paste your personal ki:connect API key below in your local .env (leave blank to boot in placeholder mode).
KICONNECT_API_KEY=
AI_EVALUATOR_PROVIDER=kiconnect-nrw
AI_EVALUATOR_BASE_URL=https://chat.kiconnect.nrw/api/v1
# Available ki:connect NRW models:
#   - OpenAI GPT OSS 120B
#   - Qwen 3.8 27B
#   - Mistral Small 4 119B
AI_EVALUATOR_MODEL=OpenAI GPT OSS 120B

# --- Bootstrap professor account (Decision 1.24) ---
# Set both values to create one PROFESSOR account at startup when no account has this email.
# The backend never changes an existing account and never logs the password.
NIFTY_BOOTSTRAP_PROFESSOR_EMAIL=
NIFTY_BOOTSTRAP_PROFESSOR_PASSWORD=

# --- Git Forge Switch (parallel GitHub / GitLab support for AI harness & scripts) ---
# Values: "github" (`gh`), "gitlab" (`glab`) or "both" (push + PR/MR on both via `node scripts/forge.mjs`)
# Remotes: `origin` = GitHub (primary), `gitlab` = GitLab (secondary, course repo).
# AI agents read ONLY these non-secret keys via `node scripts/check-setup.mjs --forge`.
GIT_FORGE=github
# GitLab host used when GIT_FORGE=gitlab or both (FH Dortmund: git.inf.fh-dortmund.de)
GITLAB_HOST=git.inf.fh-dortmund.de

# --- Optional Host-Mode Overrides (only needed when running backend/frontend outside Docker) ---
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/nifty
# SPRING_DATASOURCE_USERNAME=nifty
# SPRING_DATASOURCE_PASSWORD=nifty_dev_password
# VITE_API_PROXY_TARGET=http://localhost:8080
